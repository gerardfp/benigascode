# Benigascode Environment Configuration Example
# Copy this file to .env and configure secrets accordingly.
# NEVER commit the real .env file to Git!

# Domain and SSL
DOMAIN_NAME=benigascode.example.com
LETSENCRYPT_EMAIL=admin@example.com

# PostgreSQL Database
DB_NAME=benigascode
DB_USER=benigascode_user
DB_PASSWORD=change_this_to_a_secure_random_password_32_chars

# Benigascode Backend Security
RUNNER_TOKEN=generate_runner_secret_token_at_least_32_chars
CONTENT_STORAGE_PATH=/var/lib/benigascode/content

# Oracle Cloud Object Storage for Backups (Optional)
OCI_BUCKET_NAME=benigascode-backups
OCI_NAMESPACE=your_tenancy_namespace
OCI_REGION=eu-madrid-1

# GitHub OAuth (Opcional - Sincronización de repositorios desde la UI de profesor)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

