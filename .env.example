# CodeLab Environment Configuration Example
# Copy this file to .env and configure secrets accordingly.
# NEVER commit the real .env file to Git!

# Domain and SSL
DOMAIN_NAME=codelab.example.com
LETSENCRYPT_EMAIL=admin@example.com

# PostgreSQL Database
DB_NAME=codelab
DB_USER=codelab_user
DB_PASSWORD=change_this_to_a_secure_random_password_32_chars

# CodeLab Backend Security
RUNNER_TOKEN=generate_runner_secret_token_at_least_32_chars
CONTENT_STORAGE_PATH=/var/lib/codelab/content

# Oracle Cloud Object Storage for Backups (Optional)
OCI_BUCKET_NAME=codelab-backups
OCI_NAMESPACE=your_tenancy_namespace
OCI_REGION=eu-madrid-1

